water.geo.with_waves=False
#Absorption
water.shader.volume_density = ("clip_gaussian", 0.9, 0.1, 0.75, 1.1)
water.shader.color = ("color_category", 'seawater')
#Scattering
water.shader.scatter_color = ("color_category", 'seawater_scatter')
water.shader.anisotropy = ("clip_gaussian", 0.7, 0.2, 0.6, 0.8)
water.shader.scatter_density=("clip_gaussian", 0.015, 0.015, 0.008, 0.04)
